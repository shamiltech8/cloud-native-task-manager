pipeline {
    agent any 

    stages {
        
        stage('checkout') {
            steps {
                checkout scm
            }
        }

    stages {

        stage('project check') {
           step {
               sh 'pwd'
               sh 'ls -la'
           }
        }

    stages {

       stage('Test') {
          step {
              sh 'python3 --version'
              sh 'pytest'
          }
       }
    }

    post {
        success {
            echo 'Cloud-Native Task Manager CI pipeline completed successfully!'
        }

        failure {
            echo 'Cloud-Ntive Task Manager CI pipeline failed!'
        }
    }
}
